# =============================================================================
# CASHCHASE AI PROVIDER & BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and configure your local or cloud AI endpoints.
# =============================================================================

# Choose which AI Provider to use:
#   - "lmstudio" : Uses your local LM Studio server (Default for local testing)
#   - "runpod"   : Uses your RunPod vLLM / Serverless OpenAI-compatible GPU endpoint
#                  (falls back to LM Studio until RUNPOD_API_KEY and the endpoint are filled in)
#   - "auto"     : RunPod when RUNPOD_API_KEY and the endpoint are filled in, otherwise LM Studio
# If the AI is slow or offline (e.g. a RunPod cold start), CashChase uses its built-in answers.
AI_PROVIDER=lmstudio

# -----------------------------------------------------------------------------
# OPTION A: LM STUDIO LOCAL API (When AI_PROVIDER=lmstudio)
# -----------------------------------------------------------------------------
LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Set to "local-model" or leave blank to auto-detect loaded model:
LMSTUDIO_MODEL=local-model
LMSTUDIO_VISION_MODEL=auto

# -----------------------------------------------------------------------------
# OPTION B: RUNPOD AI CLOUD GPU (When AI_PROVIDER=runpod)
# -----------------------------------------------------------------------------
# Fill in RUNPOD_ENDPOINT_ID (the URL is built from it) or set RUNPOD_BASE_URL directly.
# The API key stays on the server; it is never sent to the WebApp or the extension.
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
RUNPOD_BASE_URL=https://api.runpod.ai/v2/your_runpod_endpoint_id_here/openai/v1
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
RUNPOD_MODEL=Qwen/Qwen3-4B-Instruct
RUNPOD_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# -----------------------------------------------------------------------------
# BACKEND SERVER
# -----------------------------------------------------------------------------
PORT=8000
# Only this computer can open CashChase. Use 0.0.0.0 to open it to everyone on the same Wi-Fi.
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# Any SQLAlchemy URL. SQLite is for local testing only (the path is relative to the project folder):
DATABASE_URL=sqlite:///backend/cashchase.db
# Later, Postgres (needs backend/schema/migrations/postgresql/ and the psycopg driver):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/cashchase

# -----------------------------------------------------------------------------
# SUPABASE LOGIN (Project Settings → API Keys / Data API)
# -----------------------------------------------------------------------------
# Use the anon / publishable key here, never the service_role / secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
