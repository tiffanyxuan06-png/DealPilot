# =============================================================================
# CASHCHASE AI PROVIDER & BACKEND CONFIGURATION (.env.example)
# Copy this file to .env and configure your local or cloud AI endpoints.
# =============================================================================

# Choose which AI Provider to use:
#   - "lmstudio" : Uses your local LM Studio server (Default for local testing)
#   - "runpod"   : Uses your RunPod vLLM / Serverless OpenAI-compatible GPU endpoint
#   - "auto"     : Tries RunPod first if RUNPOD_API_KEY is set, otherwise LM Studio
AI_PROVIDER=lmstudio

# -----------------------------------------------------------------------------
# OPTION A: LM STUDIO LOCAL API (When AI_PROVIDER=lmstudio)
# -----------------------------------------------------------------------------
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio
# Set to "local-model" or leave blank to auto-detect loaded model:
LMSTUDIO_MODEL=local-model
LMSTUDIO_VISION_MODEL=auto

# -----------------------------------------------------------------------------
# OPTION B: RUNPOD AI CLOUD GPU (When AI_PROVIDER=runpod)
# -----------------------------------------------------------------------------
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id_here
RUNPOD_BASE_URL=https://api.runpod.ai/v2/your_runpod_endpoint_id_here/openai/v1
RUNPOD_API_KEY=rpa_your_runpod_api_key_here
RUNPOD_MODEL=Qwen/Qwen3-4B-Instruct
RUNPOD_VISION_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# -----------------------------------------------------------------------------
# BACKEND SERVER PORT
# -----------------------------------------------------------------------------
PORT=8000
