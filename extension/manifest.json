{
  "manifest_version": 3,
  "name": "Closiq for WhatsApp (Orbyte SME)",
  "version": "2.0.0",
  "description": "Closiq sits beside WhatsApp Web: reads your customers' chats, quotes from your price list, drafts replies, and tracks follow-ups and commission.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:1234/*",
    "http://127.0.0.1:1234/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.replit.app/*",
    "https://*.replit.dev/*",
    "https://*.repl.co/*",
    "https://web.whatsapp.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "sidebar.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/*.png"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
